# Copy to .env and fill in values
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAMES=your_admin_username

# After pulling schema changes (badges / live clock columns), apply once against prod/dev:
#   npm run db:push
# Do this BEFORE (or immediately with) deploying code that reads the new columns.
# Netlify build does not auto-push schema (avoids accidental data loss).
