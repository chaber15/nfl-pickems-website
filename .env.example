# Copy to .env and fill in values.
# Local .env should point at the Neon **dev** branch, never production.
# Production values live only in Netlify environment variables.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin unlock passphrases (each at least 10 characters; shorter or missing = that tier can't be unlocked).
# ADMIN_PIN unlocks the admin tier (sync, badges, rename, ban/unban, registration) for users with is_admin.
ADMIN_PIN=
# SUPER_ADMIN_PIN unlocks the super tier (grant/revoke admin, delete players, factory reset)
# for users with is_super_admin. Known only to the site owner; must differ from ADMIN_PIN.
SUPER_ADMIN_PIN=

# Factory reset wipes every player, pick and badge. Leave unset (disabled) unless you
# really mean it; set to exactly "true" to enable, then remove it again afterwards.
# ALLOW_FACTORY_RESET=true

# After pulling schema changes, apply once against dev (then prod, deliberately):
#   npm run db:push
# drizzle-kit reads DATABASE_URL from .env, so double-check which branch it points at.
# Do this BEFORE (or immediately with) deploying code that reads new columns.
# Netlify build does not auto-push schema (avoids accidental data loss).
